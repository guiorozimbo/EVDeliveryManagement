# ============================================================
#  EVDeliveryManagement – Environment Variables Template
#  Copy this file to .env and fill in your values
#  ⚠️  NEVER commit the .env file to version control
# ============================================================

# PostgreSQL Configuration
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Names
POSTGRES_VEHICLE_DB=ev_vehicle_db
POSTGRES_CUSTOMER_DB=ev_customer_db
POSTGRES_DELIVERY_DB=ev_delivery_db

# Connection Strings
VEHICLE_DB_CONNECTION=Host=localhost;Port=5432;Database=ev_vehicle_db;Username=your_db_username;Password=your_secure_password_here
CUSTOMER_DB_CONNECTION=Host=localhost;Port=5432;Database=ev_customer_db;Username=your_db_username;Password=your_secure_password_here
DELIVERY_DB_CONNECTION=Host=localhost;Port=5432;Database=ev_delivery_db;Username=your_db_username;Password=your_secure_password_here

# JWT Authentication
JWT_SECRET=generate_a_random_string_with_at_least_32_characters
JWT_ISSUER=EVDeliveryGateway
JWT_AUDIENCE=EVDeliveryPlatform
JWT_EXPIRATION_MINUTES=480

# Service URLs
GATEWAY_URL=http://localhost:5000
VEHICLE_SERVICE_URL=http://localhost:5001
CUSTOMER_SERVICE_URL=http://localhost:5002
DELIVERY_SERVICE_URL=http://localhost:5003
FRONTEND_URL=http://localhost:5173
