# PostgreSQL Configuration
POSTGRES_USER=ev_admin
POSTGRES_PASSWORD=ev_delivery_secure_pass_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Names
POSTGRES_VEHICLE_DB=ev_vehicle_db
POSTGRES_CUSTOMER_DB=ev_customer_db
POSTGRES_DELIVERY_DB=ev_delivery_db

# Connection Strings
VEHICLE_DB_CONNECTION=Host=localhost;Port=5432;Database=ev_vehicle_db;Username=ev_admin;Password=ev_delivery_secure_pass_2026
CUSTOMER_DB_CONNECTION=Host=localhost;Port=5432;Database=ev_customer_db;Username=ev_admin;Password=ev_delivery_secure_pass_2026
DELIVERY_DB_CONNECTION=Host=localhost;Port=5432;Database=ev_delivery_db;Username=ev_admin;Password=ev_delivery_secure_pass_2026

# JWT Authentication
JWT_SECRET=super_secret_ev_delivery_jwt_key_2026_at_least_32_chars_long!
JWT_ISSUER=EVDeliveryGateway
JWT_AUDIENCE=EVDeliveryPlatform
JWT_EXPIRATION_MINUTES=480

# Service URLs
GATEWAY_URL=http://localhost:5000
VEHICLE_SERVICE_URL=http://localhost:5001
CUSTOMER_SERVICE_URL=http://localhost:5002
DELIVERY_SERVICE_URL=http://localhost:5003
FRONTEND_URL=http://localhost:5173
