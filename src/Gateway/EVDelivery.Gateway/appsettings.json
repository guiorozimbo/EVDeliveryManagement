{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "super_secret_ev_delivery_jwt_key_2026_at_least_32_chars_long!",
    "Issuer": "EVDeliveryGateway",
    "Audience": "EVDeliveryPlatform",
    "ExpirationMinutes": 480
  },
  "ReverseProxy": {
    "Routes": {
      "vehicles-route": {
        "ClusterId": "vehicle-cluster",
        "Match": {
          "Path": "/api/vehicles/{**catch-all}"
        }
      },
      "customers-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },
      "deliveries-route": {
        "ClusterId": "delivery-cluster",
        "Match": {
          "Path": "/api/deliveries/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "vehicle-cluster": {
        "Destinations": {
          "vehicle-service": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "customer-service": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "delivery-cluster": {
        "Destinations": {
          "delivery-service": {
            "Address": "http://localhost:5003/"
          }
        }
      }
    }
  }
}
